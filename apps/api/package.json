{
  "name": "@tastedraft/api",
  "version": "0.1.0",
  "private": true,
  "description": "TasteDraft API: deterministic resonance engine, open-data and Qloo evidence, and a score-free brief interpreter.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --import tsx --watch src/index.ts",
    "prestart": "node ../../split/build.mjs",
    "start": "node --disable-warning=ExperimentalWarning --import tsx src/index.ts",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test --test-reporter spec \"src/**/*.test.ts\"",
    "backtest": "node --disable-warning=ExperimentalWarning --import tsx scripts/backtest.ts",
    "case-studies": "node --disable-warning=ExperimentalWarning --import tsx scripts/case-studies.ts",
    "benchmark": "node --disable-warning=ExperimentalWarning --import tsx scripts/benchmark.ts",
    "persona-live": "node --disable-warning=ExperimentalWarning --import tsx scripts/persona-live.ts",
    "typecheck": "tsc --noEmit",
    "build:web": "node ../../split/build.mjs",
    "postinstall": "node scripts/link-contract-deps.mjs",
    "smoke": "node --disable-warning=ExperimentalWarning --import tsx scripts/smoke-loop.ts",
    "build:worker": "node scripts/build-worker.mjs",
    "dev:worker": "wrangler dev --port 8787",
    "deploy:worker": "wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@tastedraft/contracts": "*",
    "@tastedraft/engine-wasm": "*",
    "hono": "^4.10.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.3"
  }
}
