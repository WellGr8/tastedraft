# Copy secrets to .env.local (gitignored). The API reads .env.local before .env.
# Leave the keys empty to run the calibrated sample provider (no network calls).

# Qloo Hackathon API key. When set, evidence and search use live Qloo.
QLOO_API_KEY=

# Persona chat. OpenRouter is the default. Without a key, replies stay on the template.
# LLM_PROVIDER may also be openai, xai, or anthropic.
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-flash-lite
LLM_FALLBACK_MODEL=meta-llama/llama-3.2-3b-instruct

# wasm (default) runs the Rust engine. ts keeps the TypeScript fallback.
ENGINE=wasm

# sample | fallback | qloo
# Unset: sample when QLOO_API_KEY is empty, otherwise qloo.
EVIDENCE_PROVIDER=

# API bind. Render requires 0.0.0.0. Default port is 8787.
HOST=0.0.0.0
PORT=8787

# SQLite scratch file. The filesystem is ephemeral on Render.
DATABASE_PATH=data/tastedraft.sqlite

# Browser origin of the API, read by the Next.js app at build and dev time.
# Cloudflare Pages: set NEXT_PUBLIC_API_URL. It wins over NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8787
NEXT_PUBLIC_API_URL=

# Comma-separated browser origins. No wildcard. The API refuses other Origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8787,http://127.0.0.1:8787

# Live Qloo calls per UTC day. After this, runs play back the Recorded fixture.
QLOO_DAILY_BUDGET=400
QLOO_BUDGET_PATH=data/qloo-budget.sqlite
QLOO_CACHE_DIR=

# Requests per minute per address. /api/health is exempt. 0 disables the limit.
RATE_LIMIT_PER_MINUTE=60

# SQLite for agent runs, and the directory of derived recordings.
RUNS_PATH=data/runs.sqlite
RECORDINGS_DIR=

# Caddy site address on the VM. A hostname turns on automatic HTTPS. :80 is HTTP only.
SITE_ADDRESS=:80
