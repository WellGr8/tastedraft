# Copy to .env at the repository root. The API reads these on startup.
# Leave the keys empty to run the calibrated sample provider (no network calls).

# Qloo Hackathon API key. When set, evidence and search use live Qloo.
QLOO_API_KEY=

# OpenAI-compatible chat key for the score-free interpreter.
# Without it, parseBrief / explain / critique stay deterministic.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# wasm (default) runs the Rust engine. ts keeps the TypeScript fallback.
ENGINE=wasm

# sample | fallback | qloo
# Unset: sample when QLOO_API_KEY is empty, otherwise qloo.
EVIDENCE_PROVIDER=

# API bind. Render requires 0.0.0.0. Default port is 8787.
HOST=0.0.0.0
PORT=8787

# SQLite scratch file. The filesystem is ephemeral on Render.
DATABASE_PATH=data/tastedraft.sqlite

# Browser origin of the API, read by the Next.js app at build and dev time.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8787
